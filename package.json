{
  "name": "@younglim/extract-zip",
  "version": "2.0.2",
  "description": "unzip a zip file into a directory using 100% javascript",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "extract-zip": "cli.js"
  },
  "scripts": {
    "ava": "ava",
    "coverage": "nyc --reporter=lcov --reporter=text ava",
    "lint": "eslint .",
    "test": "npm run lint && npm run ava && npm run tsd",
    "tsd": "tsd",
    "prepare": "husky"
  },
  "files": [
    "cli.js",
    "index.d.ts"
  ],
  "author": "younglim",
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/younglim/extract-zip.git"
  },
  "keywords": [
    "unzip",
    "zip",
    "extract"
  ],
  "engines": {
    "node": ">= 18"
  },
  "dependencies": {
    "debug": "^4.4.1",
    "yauzl": "^3.4.0"
  },
  "optionalDependencies": {
    "@types/yauzl": "^2.10.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "ava": "^6.4.1",
    "eslint": "^9.39.5",
    "eslint-plugin-ava": "^15.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-promise": "^7.3.0",
    "fs-extra": "^11.4.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "nyc": "^17.1.0",
    "tsd": "^0.33.0"
  },
  "lint-staged": {
    "*.js": "npm run lint -- --fix"
  }
}
